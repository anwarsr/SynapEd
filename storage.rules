rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Foto profil ────────────────────────────────────────────────────
    // Hanya pemilik yang boleh menulis ke foldernya sendiri. Batas ukuran
    // dan tipe konten diperiksa DI SINI, bukan cuma di UI — validasi di
    // browser bisa dilewati dengan memanggil API Storage secara langsung.
    match /avatars/{uid}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Lampiran pelajaran (PDF, DOCX, dsb) ────────────────────────────
    //
    // Tertutup total dari klien — dulu `allow read: if true`, sengaja
    // dipilih supaya materi mudah diakses, tapi itu berarti siapa pun yang
    // memegang tautannya bisa mengunduh dan menyebarkannya, termasuk materi
    // kursus berbayar, tanpa peduli status login atau bayar sama sekali.
    //
    // Satu-satunya jalan masuk sekarang: route API
    // /api/courses/[slug]/asset, yang memeriksa enrollment/kepemilikan
    // lewat getCourseAccess() lalu menerbitkan URL bertanda tangan berumur
    // 5 menit. Rules di sini tidak perlu tahu apa-apa soal itu — Admin SDK
    // yang dipakai route-nya melewati rules sepenuhnya.
    match /lesson-assets/{allPaths=**} {
      allow read: if false;
      allow write: if false;   // unggah hanya lewat Firebase Console / Admin SDK
    }

    // ── Berkas kursus buatan educator ──────────────────────────────────
    //
    // Educator mengunggah langsung dari browser, jadi batas tipe dan ukuran
    // WAJIB ditegakkan di sini — pemeriksaan di form bisa dilewati dengan
    // memanggil API Storage secara langsung.
    //
    // `request.auth.token.role` membaca custom claim yang sama dengan yang
    // dipakai server. Pengguna biasa tidak punya claim itu, jadi tidak bisa
    // menitipkan berkas apa pun ke sini.
    match /course-assets/{uid}/{allPaths=**} {
      // Sama seperti lesson-assets: materi tertutup dari klien, dibaca
      // hanya lewat route API /api/courses/[slug]/asset.
      allow read: if false;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.role == 'educator'
                   && request.resource.size < 20 * 1024 * 1024
                   && isDocument();
    }

    // ── Gambar latar kursus ────────────────────────────────────────────
    //
    // Berbeda dari materi: gambar ini TERBUKA untuk dibaca siapa saja, karena
    // memang tampil di katalog publik yang bisa dilihat tanpa masuk. Tidak ada
    // yang rahasia di sini — hanya sampul kursus.
    //
    // Sengaja terpisah dari course-assets, yang tertutup rapat. Menyatukan
    // keduanya berarti memilih satu aturan baca untuk dua hal yang kebutuhan
    // kerahasiaannya berlawanan.
    match /course-thumbnails/{uid}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.role == 'educator'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Gambar QRIS merchant — TERBUKA untuk dibaca.
    //
    // Harus bisa dipindai calon pembeli yang bahkan belum punya akun, jadi
    // sama terbukanya dengan sampul kursus. Tidak ada yang rahasia: QRIS
    // statis memang dirancang untuk dipajang.
    //
    // Yang boleh menulis hanya admin. Kalau tidak, siapa pun bisa menimpanya
    // dengan QRIS miliknya sendiri dan mengalihkan seluruh pembayaran.
    match /payment-qris/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.token.role == 'admin'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Bukti bayar — TERTUTUP dari klien, baca maupun lewat URL langsung.
    //
    // Isinya tangkapan layar mutasi rekening: nama, nominal, kadang saldo.
    // `allow read: if false` di sini berarti tidak ada URL yang bisa dibagikan
    // atau ditebak — admin melihatnya lewat /api/payments/proof, yang
    // memeriksa peran lebih dulu. Pola yang sama dengan course-assets.
    //
    // Menulis dibatasi ke folder milik sendiri supaya bukti tidak bisa
    // dititipkan ke folder orang lain; Server Action memeriksa awalan path itu
    // sekali lagi sebelum menautkannya ke pesanan.
    match /payment-proofs/{uid}/{allPaths=**} {
      allow read: if false;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Berkas tugas peserta — TERTUTUP dari klien.
    //
    // Jenisnya sengaja BEBAS: peserta mengumpulkan dokumen, gambar, arsip,
    // apa pun yang diminta educator. Justru karena itu `allow read: if false`
    // tidak boleh dilonggarkan — berkas sembarang jenis yang bisa diunduh
    // siapa saja lewat URL tebakan mengubah bucket ini jadi tempat
    // menitipkan berkas berbahaya atas nama domain SynapEd.
    //
    // Yang berhak melihat hanya pengumpulnya sendiri, educator pemilik
    // kursusnya, dan admin — diperiksa di /api/submissions/file.
    match /submissions/{uid}/{allPaths=**} {
      allow read: if false;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // ── Kelas: lampiran pengajar & jawaban tugas siswa ─────────────────
    //
    // Keduanya TERTUTUP dari klien. Yang boleh membaca ditentukan keanggotaan
    // kelas, yang tinggal di Firestore — rules Storage tidak bisa
    // memeriksanya, jadi pembacaan selalu lewat route API
    // (/api/classes/attachment dan /api/classes/submission).
    //
    // Batas 20 MB dan daftar jenis di isClassFile() sejalan dengan
    // classAssignmentRules.ts. Server membaca ulang ukuran & jenis tiap
    // berkas sebelum menautkannya, jadi rules ini lapis pertama, bukan
    // satu-satunya.
    match /class-files/{uid}/{allPaths=**} {
      allow read: if false;

      // Hanya educator/admin: pengguna biasa tidak punya kelas untuk
      // diberi lampiran, dan tidak perlu tempat menitipkan berkas di sini.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.role in ['educator', 'admin']
                   && request.resource.size < 20 * 1024 * 1024
                   && (isClassFile() || isModel3d());
    }

    match /class-submissions/{uid}/{allPaths=**} {
      allow read: if false;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && isClassFile();
    }

    // PDF, JPG, PNG, DOCX, PPTX, XLSX, ZIP — daftar tertutup.
    function isClassFile() {
      return request.resource.contentType in [
        'application/pdf',
        'image/jpeg',
        'image/png',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/zip'
      ];
    }

    // Objek 3D (GLB) untuk pengumuman kelas. Hanya folder pengajar
    // (class-files); folder jawaban siswa TIDAK menerimanya.
    function isModel3d() {
      return request.resource.contentType == 'model/gltf-binary';
    }

    // Hanya PDF.
    //
    // Word sempat diizinkan, tetapi tampilannya di halaman tidak pernah setia
    // — pengurai .docx mana pun harus menerka ulang tata letak Word. Sekarang
    // materi selalu PDF, yang dirender apa adanya.
    //
    // Tetap ditulis sebagai daftar tertutup, bukan pola: 'application/.*'
    // akan ikut mengizinkan berkas yang dapat dieksekusi.
    function isDocument() {
      return request.resource.contentType in ['application/pdf'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
