rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Foto profil ────────────────────────────────────────────────────
    // Hanya pemilik yang boleh menulis ke foldernya sendiri. Batas ukuran
    // dan tipe konten diperiksa DI SINI, bukan cuma di UI — validasi di
    // browser bisa dilewati dengan memanggil API Storage secara langsung.
    match /avatars/{uid}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Lampiran pelajaran (PDF, DOCX, dsb) ────────────────────────────
    //
    // PERINGATAN YANG DISENGAJA: akses baca publik dipilih secara sadar.
    // Siapa pun yang memegang tautannya bisa mengunduh dan menyebarkannya,
    // termasuk materi kursus berbayar. Kalau nanti berubah pikiran,
    // ganti `allow read: if true` menjadi `if request.auth != null`
    // dan sajikan berkas lewat URL bertanda tangan.
    match /lesson-assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;   // unggah hanya lewat Firebase Console / Admin SDK
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
