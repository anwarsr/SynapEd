{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "synaped",
    "public": "hosting-shell",
    "ignore": ["**/.*", "README.md"],
    "redirects": [
      {
        "source": "/",
        "destination": "https://synaped--synap-ed.asia-southeast1.hosted.app/",
        "type": 302
      },
      {
        "source": "/:sisa*",
        "destination": "https://synaped--synap-ed.asia-southeast1.hosted.app/:sisa*",
        "type": 302
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
