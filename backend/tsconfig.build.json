{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Cache incremental HARUS berada di dalam dist.
    // Kalau di luar, `deleteOutDir` menghapus dist tetapi cache-nya
    // selamat — TypeScript lalu mengira semua sudah dikompilasi,
    // tidak menghasilkan apa pun, keluar dengan kode 0, dan
    // `nest start` gagal menemukan dist/main.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "**/*.spec.ts"]
}
