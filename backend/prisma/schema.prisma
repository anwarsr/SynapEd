// SynapEd — skema database
//
// Menggantikan gabungan dari:
//   - migrasi Laravel (hanya tabel users/sessions/password_reset_tokens)
//   - app/Helpers/LmsData.php (array PHP 622 baris, tidak pernah ada di DB)
//
// Data kursus sekarang menjadi tabel nyata, bukan konstanta hardcoded.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Akun & sesi ─────────────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  /// Hash bcrypt. Hash lama dari Laravel berawalan $2y$ dan dinormalkan
  /// ke $2b$ saat verifikasi — lihat PasswordService.
  password        String
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh token disimpan sebagai HASH, bukan nilai mentah — kalau DB bocor,
/// isinya tidak bisa langsung dipakai. Ini juga yang membuat logout benar-benar
/// mencabut akses, sesuatu yang tidak bisa dilakukan JWT murni.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

// ── Katalog kursus ──────────────────────────────────────────────────────

model Course {
  id         Int    @id @default(autoincrement())
  slug       String @unique
  title      String
  shortDesc  String @map("short_desc")
  longDesc   String @map("long_desc")
  level      String
  /// green | yellow | red — dipetakan ke tone chip di frontend
  levelColor String @map("level_color")
  category   String
  icon       String
  /// Kelas Tailwind untuk tint kepala kartu, mis. "bg-blue-50"
  tint       String

  durationLabel    String  @map("duration_label")
  rating           Float
  reviews          Int
  price            Int     @default(0)
  thumbnail        String?
  enrolledStudents Int     @default(0) @map("enrolled_students")
  lastUpdated      String? @map("last_updated")

  instructorName String @map("instructor_name")
  instructorBio  String @map("instructor_bio")

  /// Daftar bullet — disimpan sebagai JSON string.
  /// SQLite tidak punya tipe array, dan keduanya hanya untuk ditampilkan,
  /// tidak pernah di-query, jadi tabel terpisah cuma menambah beban.
  whatYouLearn String @map("what_you_learn")
  requirements String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections Section[]

  @@map("courses")
}

model Section {
  id       Int    @id @default(autoincrement())
  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int

  lessons Lesson[]

  @@index([courseId])
  @@map("sections")
}

model Lesson {
  id        Int     @id @default(autoincrement())
  sectionId Int     @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  /// video | reading | quiz
  type      String
  duration  String
  free      Boolean @default(false)
  position  Int

  @@unique([sectionId, slug])
  @@index([sectionId])
  @@map("lessons")
}
