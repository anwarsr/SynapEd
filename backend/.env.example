# Database (SQLite — path relatif terhadap folder prisma/)
DATABASE_URL="file:./synaped.db"

# Server
PORT=3001
NODE_ENV=development

# Asal frontend yang diizinkan (CORS, dipisah koma)
CORS_ORIGINS="http://localhost:3000"

# Rahasia JWT — WAJIB diganti di produksi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="ganti-saya-access-secret"
JWT_REFRESH_SECRET="ganti-saya-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
