# ── Pengembangan lokal dengan Firebase Emulator ────────────────────────
# Project ID berawalan "demo-" membuat emulator berjalan sepenuhnya offline:
# tidak ada koneksi ke Firebase asli, tidak perlu akun, tidak ada tagihan.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-synaped
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-synaped.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-synaped.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Dibaca sendiri oleh Admin SDK — mengarahkannya ke emulator.
# HAPUS keduanya saat menunjuk ke proyek Firebase asli.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Produksi ───────────────────────────────────────────────────────────
# Ganti nilai NEXT_PUBLIC_* di atas dengan milik proyek asli Anda
# (Firebase Console -> Project settings -> Your apps -> Web app),
# hapus dua baris EMULATOR, lalu setel NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false.
#
# Admin SDK tidak butuh kredensial di Firebase App Hosting — Application
# Default Credentials terbaca otomatis. Variabel di bawah hanya diperlukan
# untuk menjalankan skrip dari laptop terhadap proyek asli:
# FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}

# ── Asisten chat (OpenRouter) ───────────────────────────────────────────
# Kunci API dari https://openrouter.ai/keys — wajib diisi supaya widget
# chat FAQ berfungsi. Tanpa ini /api/chat mengembalikan 500.
# JANGAN diberi prefiks NEXT_PUBLIC_ — kunci ini hanya boleh dibaca server.
#
# Model utama (nvidia/nemotron-3-ultra-550b-a55b:free) gratis, dengan jatah
# 50 permintaan/hari untuk SELURUH pengunjung — naik ke 1000/hari bila akun
# OpenRouter pernah mengisi kredit minimal $10 (kreditnya sendiri tidak
# terpakai). Dua model cadangan otomatis dipakai kalau yang utama penuh.
# OPENROUTER_API_KEY=...
