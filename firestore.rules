rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Katalog kursus: boleh dibaca siapa saja (halaman publik),
    // tetapi TIDAK BOLEH ditulis dari klien sama sekali.
    //
    // Penulisan hanya lewat Admin SDK — yang melewati rules ini —
    // yaitu skrip migrasi dan Firebase Console. Tanpa panel admin,
    // memberi izin tulis ke klien hanya membuka celah tanpa manfaat.
    match /courses/{slug} {
      allow read: if true;
      allow write: if false;

      // ── Soal & jawaban kuis ─────────────────────────────────────────
      // Firestore rules TIDAK hierarkis: `allow read: if true` pada dokumen
      // induk di atas TIDAK menjangkau subcollection ini. Jadi dokumen ini
      // sudah tertutup rapat lewat penolakan menyeluruh di paling bawah —
      // blok ini murni dokumentasi & jaga-jaga terhadap suntingan ceroboh
      // di masa depan (mis. seseorang menambahkan wildcard rekursif).
      //
      // correctOptionId TIDAK BOLEH pernah bocor ke klien; itu sebabnya
      // kuis hidup di sini, terpisah dari dokumen kursus yang publik.
      match /quizzes/{lessonSlug} {
        allow read, write: if false;
      }
    }

    // ── Profil pengguna ────────────────────────────────────────────────
    // Hanya pemilik yang boleh membaca & menulis profilnya sendiri.
    //
    // Halaman admin TIDAK bergantung pada aturan ini: ia dirender di server
    // dengan Admin SDK, yang memang melewati rules. Jadi aturan di sini bisa
    // tetap seketat mungkin tanpa mengorbankan fitur admin.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && isValidProfile();

      allow delete: if false;   // penghapusan akun lewat Admin SDK
    }

    // Field yang boleh ditulis klien sengaja dikunci.
    // `role` TIDAK termasuk — role hidup sebagai custom claim. Kalau role
    // ditaruh di dokumen ini, pengguna bisa mengangkat dirinya sendiri
    // jadi admin hanya dengan menulis ke profilnya.
    function isValidProfile() {
      return request.resource.data.keys().hasOnly(['phone', 'updatedAt'])
             && (!('phone' in request.resource.data)
                 || request.resource.data.phone == null
                 || (request.resource.data.phone is string
                     && request.resource.data.phone.size() <= 20));
    }

    // ── Lamaran menjadi educator ───────────────────────────────────────
    // Tertutup rapat dari klien, baca maupun tulis.
    //
    // Seluruh alurnya berjalan lewat Server Action yang memakai Admin SDK:
    // pengguna melamar, admin memutuskan. Jadi klien tidak butuh akses
    // langsung sama sekali, dan menutupnya menghilangkan seluruh kelas
    // kesalahan aturan — termasuk pengguna yang mengubah status lamarannya
    // sendiri menjadi "accepted".
    //
    // Document ID = uid pelamar, sehingga satu akun tidak mungkin punya dua
    // lamaran yang bersaing.
    match /educatorApplications/{uid} {
      allow read, write: if false;
    }

    // ── Pendaftaran kursus & kemajuan belajar ──────────────────────────
    // Tertutup rapat dari klien, sama seperti educatorApplications.
    //
    // Seluruh alurnya lewat Server Action dengan Admin SDK: pengguna
    // mendaftar, menandai pelajaran selesai, admin memberikan akses. Klien
    // tidak pernah membacanya langsung — halaman belajar dan dashboard
    // dirender di server.
    //
    // Aturan ini sebenarnya sudah dicakup penolakan menyeluruh di bawah;
    // ditulis eksplisit supaya niatnya terbaca dan tidak diam-diam terbuka
    // kalau suatu saat ada yang menambahkan wildcard rekursif.
    //
    // Document ID = "{uid}_{slug}", sehingga satu akun tidak mungkin punya
    // dua pendaftaran yang bersaing di kursus yang sama.
    match /enrollments/{id} {
      allow read, write: if false;
    }

    // ── Sertifikat kelulusan ────────────────────────────────────────────
    // Tertutup rapat dari klien Firestore — halaman verifikasi publik
    // (/verify/{id}) membacanya lewat Admin SDK di Server Component, BUKAN
    // lewat SDK klien, jadi rules ini tidak perlu dilonggarkan untuk itu.
    //
    // ID sertifikat acak (bukan turunan uid+slug) supaya URL sertifikat
    // orang lain tidak bisa ditebak; rules tertutup ini adalah lapis kedua,
    // menutup jalur enumerasi lewat query langsung ke koleksi.
    match /certificates/{id} {
      allow read, write: if false;
    }

    // ── Pengajuan perubahan kursus ─────────────────────────────────────
    // Tertutup rapat dari klien, baca maupun tulis.
    //
    // Dokumen ini memuat usulan perubahan beserta salinan "sebelum" dan
    // "sesudah" isi kursus. Kalau klien bisa menulis, educator dapat
    // menyetujui pengajuannya sendiri hanya dengan mengubah field `status`,
    // dan seluruh gunanya persetujuan admin lenyap.
    //
    // Educator melihat pengajuannya lewat halaman yang dirender server, jadi
    // akses baca langsung pun tidak diperlukan.
    match /courseChangeRequests/{id} {
      allow read, write: if false;
    }

    // ── Pesanan pembayaran ─────────────────────────────────────────────
    // Tertutup rapat dari klien, baca maupun tulis.
    //
    // Dokumen ini menentukan apakah seseorang berhak atas kursus berbayar,
    // jadi ia harus mustahil disentuh dari browser. Kalau klien bisa menulis,
    // siapa pun cukup mengubah status pesanannya sendiri menjadi "paid".
    // Membacanya pun tidak perlu: halaman dirender di server.
    //
    // Pembuatnya adalah Server Action (createOrder) dan satu-satunya yang
    // menandainya lunas adalah webhook Midtrans — keduanya memakai Admin SDK
    // yang melewati rules ini.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // ── Ulasan kursus ──────────────────────────────────────────────────
    // Ditulis HANYA lewat Server Action, yang lebih dulu memastikan penulisnya
    // punya enrollment berstatus "completed" untuk kursus itu. Kalau klien
    // boleh menulis langsung, syarat itu lenyap: siapa pun bisa mengarang
    // bintang lima untuk kursus yang tidak pernah ia buka, dan rata-rata
    // bintang di katalog kehilangan artinya.
    //
    // Membacanya pun tidak perlu dari browser — beranda dan halaman detail
    // kursus keduanya dirender di server.
    match /reviews/{id} {
      allow read, write: if false;
    }

    // ── Kategori kursus ────────────────────────────────────────────────
    // Dikelola admin lewat Server Action yang memakai Admin SDK, dan dibaca
    // di server saat merender daftar filter maupun pilihan di form. Klien
    // tidak pernah perlu menyentuhnya sendiri, jadi ditutup sepenuhnya.
    match /categories/{slug} {
      allow read, write: if false;
    }

    // Tolak apa pun di luar yang tersebut di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
